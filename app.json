{
  "expo": {
    "name": "Reno",
    "slug": "reno",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "reno",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.athanir.reno",
      "supportsTablet": true,
      "associatedDomains": [
        "webcredentials:insightful-viper-971.convex.site",
        "applinks:insightful-viper-971.convex.site"
      ],
      "appleTeamId": "NSJPQ3TSBT",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "com.athanir.reno",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "backgroundColor": "#F8F5EF"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F5EF",
          "image": "./assets/brand/splash.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Reno to add photos to your project notebook.",
          "cameraPermission": "Allow Reno to take photos of your project.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8b4ab78b-4f2b-45e1-a6e5-eecfb4a1821e"
      }
    },
    "owner": "athanir"
  }
}
